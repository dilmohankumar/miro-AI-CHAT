# Server
PORT=4200
NODE_ENV=development

# OpenAI (get a key at platform.openai.com)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Abuse / cost protection
CHAT_RATE_LIMIT_PER_MIN=20     # messages per IP per minute
DAILY_CHAT_LIMIT=500           # total AI messages per day (all visitors)

# Chat logs are stored in MongoDB (local: mongod / docker, live: Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/website_chatbot

# Chat logs older than this many days are auto-deleted
LOG_RETENTION_DAYS=30
