# Copy this file to .env and fill in real values. NEVER put real keys in this example file (it is meant to be shared/committed).

# Server
PORT=4200
NODE_ENV=development            # set to "production" on the live server

# Websites allowed to use the chatbot (comma separated, full URLs). Empty = ANY website. Set this before going live!
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# AI: tried in this order. Leave a key empty to skip that provider.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# Chat logs (MongoDB). Entries older than LOG_RETENTION_DAYS are deleted automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/website_chatbot
LOG_RETENTION_DAYS=30

# Abuse / cost protection
CHAT_RATE_LIMIT_PER_MIN=20      # messages per IP per minute
DAILY_CHAT_LIMIT=500            # total AI answers per day (all visitors)
